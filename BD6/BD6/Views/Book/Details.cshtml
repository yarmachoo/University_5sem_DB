@model BD6.Entities.Book

@{
    ViewData["Title"] = "Book Details";
}

<h2>@Model.Name</h2>

<div class="book-details">
    <div class="book-info">
        <h3>Book Information</h3>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Price:</strong> $@Model.Price</p>
        <p><strong>Assesment:</strong> @(Model.Assesment.HasValue ? Model.Assesment.Value.ToString("0.0") : "N/A")</p>
        <h4>Publishing Details</h4>
        <p><strong>Publishing:</strong> @Model.Publishing?.Name</p>
        <p><strong>Location:</strong> @Model.Publishing?.PlaceOfPublish?.Street, @Model.Publishing?.PlaceOfPublish?.City, @Model.Publishing?.PlaceOfPublish?.Country</p>
        <h4>Authors</h4>
        <p>@string.Join(", ", Model.Authors ?? new List<string>())</p>
        <h4>Categories</h4>
        <p>@string.Join(", ", Model.Categories ?? new List<string>())</p>
    </div>

    <div class="book-reviews">
        <h3>Reviews</h3>
        @if (ViewData["Reviews"] is List<BD6.Entities.Feedback> reviews)
        {
            if (reviews.Count == 0)
            {
                <p>No reviews yet.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var review in reviews)
                    {
                        <li class="list-group-item">
                            <p><strong>User:</strong> @review.User.Email</p>
                            <p><strong>Assesment:</strong> @(review.Assesment.HasValue ? review.Assesment.Value.ToString("0.0") : "N/A")</p>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</div>

<div class="action-buttons">
    <a href="@Url.Action("Index", "Book")" class="btn btn-secondary">Back to List</a>
    <a href="@Url.Action("Delete", "Book", new { id = Model.BookId })" class="btn btn-danger">Delete Book</a>
</div>
