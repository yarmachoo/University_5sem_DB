@model IEnumerable<BD6.Entities.Book>
@{
    ViewData["Title"] = "Manage Books";
}

<h2>Управление книгами</h2>

<table class="table">
    <thead>
        <tr>
            <th>Название книги</th>
            <th>Описание</th>
            <th>Цена</th>
            <th>Оценка</th>
            <th>Издательство</th>
            <th>Авторы</th>
            <th>Категории</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td><a href="@Url.Action("Details", "Book", new { id = book.BookId })">@book.Name</a></td>
                <td>@book.Description</td>
                <td>@book.Price</td>
                <td>@(book.Assesment.HasValue ? book.Assesment.Value.ToString("0.0") : "N/A")</td>
                <td>
                    @book.Publishing?.Name<br />
                    @book.Publishing?.PlaceOfPublish?.Street<br />
                    @book.Publishing?.PlaceOfPublish?.City, @book.Publishing?.PlaceOfPublish?.Country
                </td>
                <td>@string.Join(", ", book.Authors ?? new List<string>())</td>
                <td>@string.Join(", ", book.Categories ?? new List<string>())</td>
                <td>
                    <a href="@Url.Action("Delete", "Book", new { bookId = book.BookId })" class="btn btn-danger btn-sm">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Create", "Book")" class="btn btn-primary">Добавить новую книгу</a>
